# Copy to .env and edit. Never commit .env.
#
# Only passwords, private addresses and what Docker itself needs are here. Everything else is in
# config/: connections.yaml refers to these values as ${NAME}.

COMPOSE_PATH_SEPARATOR=:

# ------ for local ------
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# ------ for VM ------
# COMPOSE_FILE=docker-compose.yml:docker-compose.vm.yml
# PLATFORM_NETWORK=qdrant_default
# POSTGRES_HOST=postgres18

OLLAMA_BASE_URL=http://192.168.1.88:11434
QDRANT_BASE_URL=http://qdrant-qdrant-1:6333

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=welcome1

DAGSTER_POSTGRES_DB=dagster

SQL_LOADER_PASSWORD=welcome1
SQL_READER_PASSWORD=welcome1

# ------ for VM ------
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# The key a caller of the HTTP API must send, when config/connections.yaml asks for one (`api.key`).
# RAG_API_KEY=
