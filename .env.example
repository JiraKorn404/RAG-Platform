# Copy to .env and edit. Never commit .env.
#
# Only passwords and private addresses are here. Everything else is in config/: connections.yaml refers
# to these values as ${NAME}.

# Ollama. On this machine: http://host.docker.internal:11434. On another machine it must listen on all
# interfaces (OLLAMA_HOST=0.0.0.0); use its IP address (for Tailscale the 100.x.y.z one), not a name.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# PostgreSQL's admin role. It owns the databases `dagster` (Dagster's own) and `rag_metrics`.
# The passwords go into a URL, so use letters and digits only.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# The two roles of the database for imported tables: one loads data, one only reads. They are made
# with these passwords when the stack starts.
SQL_LOADER_PASSWORD=change-me-too
SQL_READER_PASSWORD=change-me-as-well
