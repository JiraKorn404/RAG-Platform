# Copy to .env and edit. Never commit .env.
#
# Only passwords, private addresses and what Docker itself needs are here. Everything else is in
# config/: connections.yaml refers to these values as ${NAME}.

# Which compose files `docker compose` uses. This machine hosts its own PostgreSQL and Qdrant:
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# On a server that already has them, join their Docker network instead (`docker network ls`):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vm.yml
# PLATFORM_NETWORK=platform_default

# Ollama. On this machine: http://host.docker.internal:11434. On another machine it must listen on all
# interfaces (OLLAMA_HOST=0.0.0.0); use its IP address (for Tailscale the 100.x.y.z one), not a name.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# PostgreSQL: the server (`postgres` is the local container), and the role that owns our tables and
# Dagster's. Locally it is also the server's admin. The passwords go into a URL, so use letters and
# digits only.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me

# Dagster's own database on that server.
DAGSTER_POSTGRES_DB=dagster

# The two roles of the database the SQL chatbot answers from: one loads the CSV files, one only reads.
# scripts/provision.sql makes them with these passwords (the local stack runs it when it starts). A
# server whose tables are already there has no loader.
SQL_LOADER_PASSWORD=change-me-too
SQL_READER_PASSWORD=change-me-as-well

# The key a caller of the HTTP API must send, when config/connections.yaml asks for one (`api.key`).
# RAG_API_KEY=
